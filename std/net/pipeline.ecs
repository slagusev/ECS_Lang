// =========================================================================
// ECSLang Standard Network Pipelines
// =========================================================================

pipeline NetPipeline {
    stage NetPoll {
        NetPollThrottleSystem;
        TcpListenerSystem;
        TcpReceiverSystem;
        UdpReceiverSystem;
    }
    stage NetFlush {
        swap_events;
        OutboundSendSystem;
    }
    stage NetCleanup {
        apply_commands;
        TcpConnectionDestructorSystem;
        TcpListenerDestructorSystem;
        UdpSocketDestructorSystem;
        apply_commands;
    }
}

