// =========================================================================
// ECSLang Standard Network Library
// Pure Data-Oriented ECS Network Subsystem
// =========================================================================

import "net/components.ecs";
import "net/events.ecs";
import "net/systems.ecs";
import "net/pipeline.ecs";

fn net_start(): i32 {
    return raw_net_init();
}

fn net_stop() {
    raw_net_cleanup();
}

fn net_tcp_listen(port: i32): Result<i32, string> {
    let fd = raw_net_tcp_listen(port);
    if fd > 0 {
        return Ok(fd);
    }
    return Err($"Failed to bind TCP listener on port {port}");
}

fn net_tcp_connect(ip: string, port: i32): Result<i32, string> {
    let fd = raw_net_tcp_connect(ip, port);
    if fd > 0 {
        return Ok(fd);
    }
    return Err($"Failed to connect TCP client to {ip}:{port}");
}

fn net_udp_bind(port: i32): Result<i32, string> {
    let fd = raw_net_udp_bind(port);
    if fd > 0 {
        return Ok(fd);
    }
    return Err($"Failed to bind UDP socket on port {port}");
}

fn net_udp_connect(fd: i32, ip: string, port: i32): Result<i32, string> {
    let res = raw_net_udp_connect(fd, ip, port);
    if res == 0 {
        return Ok(fd);
    }
    return Err($"Failed to connect UDP socket to {ip}:{port}");
}

fn net_poll_wait(ms: i32) {
    raw_net_poll_wait(ms);
}

// -------------------------------------------------------------------------
// Pure ECS Factory Functions
// -------------------------------------------------------------------------

fn net_spawn_tcp_listener(world: World, port: i32): Result<entity, string> {
    let res = net_tcp_listen(port);
    match res {
        Ok(fd) => {
            let ent = world.spawn();
            world.set_TcpListener(ent, port, fd, true);
            world.set_name(ent, $"net_fd_{fd}");
            return Ok(ent);
        }
        Err(err) => {
            return Err(err);
        }
    }
}

fn net_spawn_tcp_client(world: World, ip: string, port: i32): Result<entity, string> {
    let res = net_tcp_connect(ip, port);
    match res {
        Ok(fd) => {
            let ent = world.spawn();
            world.set_TcpConnection(ent, fd, ip, port, true);
            world.set_name(ent, $"net_fd_{fd}");
            return Ok(ent);
        }
        Err(err) => {
            return Err(err);
        }
    }
}

fn net_spawn_udp_socket(world: World, port: i32): Result<entity, string> {
    let res = net_udp_bind(port);
    match res {
        Ok(fd) => {
            let ent = world.spawn();
            world.set_UdpSocket(ent, port, fd, true);
            world.set_name(ent, $"net_fd_{fd}");
            return Ok(ent);
        }
        Err(err) => {
            return Err(err);
        }
    }
}

fn net_spawn_udp_connected_socket(world: World, local_port: i32, remote_ip: string, remote_port: i32): Result<entity, string> {
    let res = net_udp_bind(local_port);
    match res {
        Ok(fd) => {
            let conn_res = net_udp_connect(fd, remote_ip, remote_port);
            match conn_res {
                Ok(ok_fd) => {
                    let ent = world.spawn();
                    world.set_UdpSocket(ent, local_port, fd, true);
                    world.set_name(ent, $"net_fd_{fd}");
                    return Ok(ent);
                }
                Err(err) => {
                    net_close(fd);
                    return Err(err);
                }
            }
        }
        Err(err) => {
            return Err(err);
        }
    }
}

// -------------------------------------------------------------------------
// Option<T> Integration: Entity Lookup by Socket fd
// -------------------------------------------------------------------------

fn net_find_entity_by_fd(world: World, fd: i32): Option<entity> {
    return world.find($"net_fd_{fd}");
}

// -------------------------------------------------------------------------
// Pure ECS Destructor Helper
// -------------------------------------------------------------------------

fn net_close_entity(world: World, ent: entity) {
    world.add_SocketClosing(ent);
}

