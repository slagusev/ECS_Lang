component Position {
    x: f32,
    y: f32,
}

component Velocity {
    vx: f32,
    vy: f32,
}

component Health {
    hp: f32,
    max_hp: f32,
}

component Score {
    points: i32,
}

system MovementSystem {
    query(mut pos: Position, vel: Velocity) {
        pos.x += vel.vx;
        pos.y += vel.vy;
    }
}

system RegenSystem {
    query(mut h: Health) {
        if h.hp < h.max_hp {
            h.hp += 1.0;
        }
    }
}

system ScoreSystem {
    query(mut s: Score) {
        s.points += 10;
    }
}

pipeline ParallelGameLoop {
    stage Simulation {
        parallel {
            MovementSystem;
            RegenSystem;
            ScoreSystem;
        }
    }
}

pipeline SequentialGameLoop {
    stage Simulation {
        MovementSystem;
        RegenSystem;
        ScoreSystem;
    }
}

resource InvariantErrors {
    errors: i32,
}

system ValidateSimulationSystem {
    query(pos: Position, h: Health, s: Score, mut err: InvariantErrors) {
        if pos.x != 15.0 {
            err.errors += 1;
        }
        if pos.y != -5.0 {
            err.errors += 1;
        }
        if h.hp != 60.0 {
            err.errors += 1;
        }
        if s.points != 100 {
            err.errors += 1;
        }
    }
}

pipeline VerifyPipeline {
    stage Check {
        ValidateSimulationSystem;
    }
}

fn main(): i32 {
    let mut world = ecs::create_world();
    world.set_InvariantErrors(0);

    let count = 100000;
    println($"Spawning {count} entities with 4 components...");
    for i in 0..count {
        let e = world.spawn();
        world.set_Position(e, 0.0, 0.0);
        world.set_Velocity(e, 1.5, -0.5);
        world.set_Health(e, 50.0, 100.0);
        world.set_Score(e, 0);
    }

    // Run 10 ticks in parallel
    for tick in 0..10 {
        ParallelGameLoop(world);
    }

    println("Verifying simulation state across all 100,000 entities after 10 parallel ticks...");
    VerifyPipeline(world);

    let final_errors = world.get_InvariantErrors().errors;
    if final_errors != 0 {
        println($"INVARIANT VIOLATION: detected {final_errors} entity state mismatches!");
        return 1;
    }

    println("B5.1 Parallel Invariant: PASSED (100k entities deterministic match)");
    return 0;
}
