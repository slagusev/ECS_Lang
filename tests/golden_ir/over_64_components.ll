  %co_col_slot = getelementptr inbounds [72 x ptr], ptr %cols_arr, i32 0, i32 0
  %co_raw = load ptr, ptr %co_col_slot, align 8
  %co_elem = getelementptr inbounds %struct.ChildOf, ptr %co_raw, i32 %cur_row
  %c70_col_slot = getelementptr inbounds [72 x ptr], ptr %cols_arr, i32 0, i32 70
  %c70_raw = load ptr, ptr %c70_col_slot, align 8
  %c70_elem = getelementptr inbounds %struct.C70, ptr %c70_raw, i32 %cur_row
  %res_res_slot = getelementptr inbounds nuw %struct.EcsWorld, ptr %world, i32 0, i32 12
  %c70_v = getelementptr inbounds nuw %struct.C70, ptr %c70_elem, i32 0, i32 0
  %v_val = load i32, ptr %c70_v, align 4
  %eq = icmp eq i32 %v_val, 1000
