component Position {
    x: f32,
    y: f32,
}

component Velocity {
    vx: f32,
    vy: f32,
}

resource Time {
    dt: f32,
}

system MovementSystem {
    query(mut pos: Position, vel: Velocity, time: Time) {
        pos.x += vel.vx * time.dt;
        pos.y += vel.vy * time.dt;
    }
}

system PrintSystem {
    query(pos: Position) {
        println("Entity Position:");
        println(pos.x);
        println(pos.y);
    }
}

pipeline GameLoop {
    stage Update {
        MovementSystem;
        PrintSystem;
    }
}

fn main(): i32 {
    println("--- Starting ECS Archetype Simulation ---");

    let mut world = ecs::create_world();

    // Setup delta time
    world.set_Time(0.5);

    // Spawn entity 0: pos = (10, 20), vel = (2, -1)
    let e0 = world.spawn();
    world.set_Position(e0, 10.0, 20.0);
    world.set_Velocity(e0, 2.0, -1.0);

    // Spawn entity 1: pos = (100, 200), vel = (5, 10)
    let e1 = world.spawn();
    world.set_Position(e1, 100.0, 200.0);
    world.set_Velocity(e1, 5.0, 10.0);

    println("=== Frame 1 ===");
    GameLoop(world);

    println("=== Frame 2 ===");
    GameLoop(world);

    println("--- Simulation Finished Successfully! ---");
    return 0;
}
