component Position {
    x: f32,
    y: f32,
}

component Velocity {
    vx: f32,
    vy: f32,
}

component Ball {
    radius: f32,
    r: i32,
    g: i32,
    b: i32,
}

system BallMovementSystem {
    query(mut pos: Position, mut vel: Velocity, ball: Ball) {
        pos.x += vel.vx;
        pos.y += vel.vy;

        // Bounce horizontally
        if pos.x <= ball.radius {
            pos.x = ball.radius;
            vel.vx = -vel.vx;
        }
        if pos.x >= 800.0 - ball.radius {
            pos.x = 800.0 - ball.radius;
            vel.vx = -vel.vx;
        }

        // Bounce vertically
        if pos.y <= 90.0 + ball.radius {
            pos.y = 90.0 + ball.radius;
            vel.vy = -vel.vy;
        }
        if pos.y >= 580.0 - ball.radius {
            pos.y = 580.0 - ball.radius;
            vel.vy = -vel.vy;
        }
    }
}

system BallRenderSystem {
    query(pos: Position, ball: Ball) {
        draw_circle(pos.x, pos.y, ball.radius, ball.r, ball.g, ball.b);
    }
}

pipeline GamePipeline {
    stage Update {
        BallMovementSystem;
    }
    stage Render {
        BallRenderSystem;
    }
}

fn main(): i32 {
    println("=== ECSLang + Raylib 60 FPS Game Engine Demo ===");

    // Initialize native 60 FPS window
    init_window(800, 600, "ECSLang Native Raylib 60 FPS Demo");
    set_target_fps(60);

    // Create isolated ECS World
    let mut world = ecs::create_world();

    // Spawn bouncing ball entities with different positions, velocities and colors
    let b1 = world.spawn();
    world.set_Position(b1, 150.0, 200.0);
    world.set_Velocity(b1, 4.0, 3.2);
    world.set_Ball(b1, 22.0, 250, 70, 90);

    let b2 = world.spawn();
    world.set_Position(b2, 350.0, 250.0);
    world.set_Velocity(b2, -3.5, 4.5);
    world.set_Ball(b2, 26.0, 80, 230, 110);

    let b3 = world.spawn();
    world.set_Position(b3, 500.0, 180.0);
    world.set_Velocity(b3, 5.0, -3.8);
    world.set_Ball(b3, 18.0, 80, 180, 255);

    let b4 = world.spawn();
    world.set_Position(b4, 220.0, 380.0);
    world.set_Velocity(b4, -4.2, -4.0);
    world.set_Ball(b4, 20.0, 255, 220, 60);

    let b5 = world.spawn();
    world.set_Position(b5, 620.0, 320.0);
    world.set_Velocity(b5, 3.6, 5.2);
    world.set_Ball(b5, 16.0, 230, 100, 250);

    // Player paddle state
    let mut paddle_x = 340.0;
    let paddle_y = 550.0;
    let paddle_w = 120.0;
    let paddle_h = 18.0;

    println("Window opened! Running 60 FPS interactive game loop...");

    // 60 FPS Game Loop
    while !window_should_close() {
        // Handle input: Left (263) / Right (262) or A (65) / D (68)
        if is_key_down(263) || is_key_down(65) {
            paddle_x -= 8.0;
            if paddle_x < 10.0 {
                paddle_x = 10.0;
            }
        }
        if is_key_down(262) || is_key_down(68) {
            paddle_x += 8.0;
            if paddle_x > 670.0 {
                paddle_x = 670.0;
            }
        }

        // Frame rendering
        begin_drawing();
        clear_background(22, 26, 36);

        // Header and decorative lines
        draw_rectangle(0, 0, 800, 75, 16, 19, 28);
        draw_line(0, 75, 800, 75, 45, 52, 72);

        draw_text("ECSLang + Raylib Native Graphics Demo", 24, 16, 22, 255, 255, 255);
        draw_text("Use [<-] [->] or [A] [D] to move paddle | ESC or [X] to close", 24, 46, 15, 170, 185, 205);
        draw_text("60 FPS", 710, 24, 22, 90, 240, 130);

        // Execute ECS Game Loop (MovementSystem + BallRenderSystem)
        GamePipeline(world);

        // Render player paddle
        draw_rectangle(paddle_x, paddle_y, paddle_w, paddle_h, 70, 200, 250);

        end_drawing();
    }

    close_window();
    println("Window closed successfully. Done!");
    return 0;
}
