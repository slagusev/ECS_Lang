// ========================================================================
// ECSLang Example 14: Pure Data-Oriented Network Subsystem (TCP & UDP)
// Demonstrates pure ECS network architecture: non-blocking sockets modeled as
// components, reactive events for packet I/O, Option<Entity> socket lookup,
// Result<Entity, string> factory functions, and automated ECS socket destructors.
// ========================================================================

import "std/net.ecs";

component ClientTag {
    sent: bool,
    tcp_verified: bool,
    udp_verified: bool,
}

component UdpClientTag {
    sent: bool,
    verified: bool,
}

// System 1: Client system that initiates outbound network traffic via ECS events
system ClientSenderSystem {
    query(mut tag: ClientTag, conn: TcpConnection) {
        if !tag.sent {
            tag.sent = true;

            // Option<T> Verification: Lookup connection entity by socket fd
            let opt_ent = net_find_entity_by_fd(world, conn.fd);
            match opt_ent {
                Some(e) => {
                    println($"[Option<T> Lookup] SUCCESS: Found entity {e} for TCP fd={conn.fd}");
                }
                None => {
                    println($"[Option<T> Lookup] FAILED: Could not find entity for TCP fd={conn.fd}");
                }
            }

            // Option<T> Verification: Lookup non-existent fd (returns None)
            match net_find_entity_by_fd(world, 99999) {
                Some(e) => {
                    println("[Option<T> Lookup] FAILED: Unexpected entity returned for fd=99999");
                }
                None => {
                    println("[Option<T> Lookup] SUCCESS: None returned for non-existent fd=99999");
                }
            }

            world.emit_NetPacketSend(conn.fd, "Hello ECSLang Network!");
            println($"[Client System] Queued TCP send on fd={conn.fd}");
        }
    }
}

// System 2: Client system that initiates outbound UDP datagrams via ECS events
system UdpClientSenderSystem {
    query(mut tag: UdpClientTag, u: UdpSocket) {
        if !tag.sent {
            tag.sent = true;
            world.emit_NetPacketSend(u.fd, "UDP Datagram to ECS!");
            println($"[Client System] Queued UDP send on fd={u.fd}");
        }
    }
}

// System 3: Server Echo system - uniformly processes ANY packet and responds via NetPacketSend
system EchoHandlerSystem {
    read(packet: NetPacketReceived) {
        println($"[Server System] Received inbound packet: '{packet.payload}' from fd={packet.fd}");
        let echo_payload = $"ECHO: {packet.payload}";
        world.emit_NetPacketSend(packet.fd, echo_payload);
    }
}

resource EchoVerifier {
    tcp_verified: bool,
    udp_verified: bool,
}

// System 4: Client response verifier - listens on reactive NetPacketReceived events
system ClientEchoVerifierSystem {
    read(packet: NetPacketReceived, mut verifier: EchoVerifier) {
        if packet.payload == "ECHO: Hello ECSLang Network!" {
            println($"[Client System] Received verified TCP response: '{packet.payload}' from fd={packet.fd}");
            verifier.tcp_verified = true;
        }
        if packet.payload == "ECHO: UDP Datagram to ECS!" {
            println($"[Client System] Received verified UDP response: '{packet.payload}' from fd={packet.fd}");
            verifier.udp_verified = true;
        }
    }
}

// System 5: Monitor network send errors
system NetErrorHandlerSystem {
    read(err: NetEventSendFailed) {
        println($"[NetErrorHandler] Outbound packet send failed on fd={err.fd} (error={err.error_code})");
    }
}

pipeline NetEchoServerPipeline {
    stage NetPoll {
        NetPollThrottleSystem;
        TcpListenerSystem;
        TcpReceiverSystem;
        UdpReceiverSystem;
    }
    stage BusinessLogic {
        swap_events;
        ClientSenderSystem;
        UdpClientSenderSystem;
        EchoHandlerSystem;
        ClientEchoVerifierSystem;
        NetErrorHandlerSystem;
    }
    stage NetFlush {
        swap_events;
        OutboundSendSystem;
    }
    stage NetCleanup {
        apply_commands;
        TcpConnectionDestructorSystem;
        TcpListenerDestructorSystem;
        UdpSocketDestructorSystem;
        apply_commands;
    }
}

fn main(): i32 {
    println("=================================================");
    println("    ECSLang Example 14: Pure DOD Network (ECS)   ");
    println("=================================================\n");

    // 1. Initialize Network Subsystem (WSAStartup on Windows)
    let init_res = net_start();
    println($"1. Net initialization result: {init_res}");

    let mut world = ecs::create_world();

    let tcp_port = 39871;
    let udp_server_port = 39872;
    let udp_client_port = 39873;

    // 2. Factory Functions: Spawn TCP Server Entity (Result<entity, string>)
    let mut tcp_srv_ent = 0;
    match net_spawn_tcp_listener(world, tcp_port) {
        Ok(ent) => {
            tcp_srv_ent = ent;
            println($"2. TCP Server entity spawned: {ent} (port {tcp_port})");
        }
        Err(e) => {
            println($"ERROR: {e}");
            return 1;
        }
    }

    // 3. Factory Functions: Spawn UDP Server Entity
    let mut udp_srv_ent = 0;
    match net_spawn_udp_connected_socket(world, udp_server_port, "127.0.0.1", udp_client_port) {
        Ok(ent) => {
            udp_srv_ent = ent;
            println($"3. UDP Server entity spawned: {ent} (port {udp_server_port} -> peer {udp_client_port})");
        }
        Err(e) => {
            println($"ERROR: {e}");
            return 1;
        }
    }

    // 4. Factory Functions: Spawn TCP Client Entity
    let mut tcp_cl_ent = 0;
    match net_spawn_tcp_client(world, "127.0.0.1", tcp_port) {
        Ok(ent) => {
            tcp_cl_ent = ent;
            world.set_ClientTag(ent, false, false, false);
            println($"4. TCP Client entity spawned: {ent}");
        }
        Err(e) => {
            println($"ERROR: {e}");
            return 1;
        }
    }

    // 5. Factory Functions: Spawn UDP Client Entity
    let mut udp_cl_ent = 0;
    match net_spawn_udp_connected_socket(world, udp_client_port, "127.0.0.1", udp_server_port) {
        Ok(ent) => {
            udp_cl_ent = ent;
            world.set_UdpClientTag(ent, false, false);
            println($"5. UDP Client entity spawned: {ent} (port {udp_client_port} -> peer {udp_server_port})");
        }
        Err(e) => {
            println($"ERROR: {e}");
            return 1;
        }
    }

    // 6. Execution Loop: Dynamic while !server_should_stop with Micro-Sleep
    println("6. Running ECS network pipeline with non-blocking poll & micro-sleep...");
    world.set_EchoVerifier(false, false);
    let mut server_should_stop = false;
    let mut ticks = 0;
    while !server_should_stop && ticks < 200 {
        NetEchoServerPipeline(world);
        ticks += 1;

        let verifier = world.get_EchoVerifier();
        if verifier.tcp_verified && verifier.udp_verified {
            server_should_stop = true;
        }
    }

    if !server_should_stop {
        println("ERROR: Timeout waiting for echo verification!");
        return 1;
    }
    println($"   Echo verification completed deterministically after {ticks} pipeline ticks.");

    // 7. ECS Destructor System: Gracefully close all sockets and despawn entities
    println("7. Triggering ECS Socket Destructors...");
    net_close_entity(world, tcp_srv_ent);
    net_close_entity(world, tcp_cl_ent);
    net_close_entity(world, udp_srv_ent);
    net_close_entity(world, udp_cl_ent);

    // Ticking pipeline executes the NetCleanup stage
    NetEchoServerPipeline(world);

    net_stop();

    println("\nPure ECS Network Subsystem verified successfully!");
    println("Press any key to exit...");
    wait_key();
    return 0;
}
