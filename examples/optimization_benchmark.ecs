// Stage 16: LLVM Optimization Benchmark (Debug -O0 vs Release -O3)
// Evaluates performance on 100,000 particle entities with intensive math operations:
// position integration, damping, gravity, bounding box collision checks.

component Position {
    x: f32,
    y: f32,
    z: f32
}

component Velocity {
    vx: f32,
    vy: f32,
    vz: f32
}

component Particle {
    mass: f32,
    life: f32
}

resource Environment {
    gravity: f32,
    damping: f32,
    dt: f32
}

system IntegrateParticles {
    query(mut pos: Position, mut vel: Velocity, mut part: Particle, env: Environment) {
        vel.vy -= env.gravity * env.dt;
        vel.vx *= env.damping;
        vel.vy *= env.damping;
        vel.vz *= env.damping;

        pos.x += vel.vx * env.dt;
        pos.y += vel.vy * env.dt;
        pos.z += vel.vz * env.dt;

        part.life -= env.dt;
        if part.life <= 0.0 {
            part.life = 100.0;
        }
    }
}

system BoundaryCollision {
    query(mut pos: Position, mut vel: Velocity) {
        if pos.y < 0.0 {
            pos.y = 0.0;
            vel.vy = -vel.vy * 0.8;
        }
        if pos.x < -500.0 {
            pos.x = -500.0;
            vel.vx = -vel.vx * 0.8;
        }
        if pos.x > 500.0 {
            pos.x = 500.0;
            vel.vx = -vel.vx * 0.8;
        }
    }
}

pipeline PhysicsSimulation {
    stage Simulate {
        IntegrateParticles;
        BoundaryCollision;
    }
}

fn main(): i32 {
    println("=== Stage 16: LLVM Optimization Benchmark (100k Particles) ===");

    let mut world = ecs::create_world();
    world.set_Environment(9.81, 0.99, 0.016);

    let count = 100000;
    println("Spawning %d particle entities...", count);

    for i in 0..count {
        let e = world.spawn();
        world.add_Position(e, 0.0, 100.0, 0.0);
        world.add_Velocity(e, 5.0, 10.0, 2.0);
        world.add_Particle(e, 1.0, 50.0);
    }

    println("Warming up simulation...");
    PhysicsSimulation(world);

    let frames = 20;
    println("Running %d simulation frames over %d particles...", frames, count);

    let start_time = get_tick_count();
    for f in 0..frames {
        PhysicsSimulation(world);
    }
    let total_ms = get_tick_count() - start_time;
    let avg_frame_ms = total_ms / frames;

    println("Simulation finished: %d frames in %d ms (average %d ms / frame)", frames, total_ms, avg_frame_ms);
    println("=== Benchmark Completed Successfully ===");
    return 0;
}
