// Stage 14: Multithreading & Job System Benchmark
// Demonstrates:
// 1. Static DAG analysis ensuring zero data races across parallel systems
// 2. Win32 ThreadPool native job execution across CPU cores
// 3. Performance comparison on 100,000 entities

component Position {
    x: f32,
    y: f32
}

component Velocity {
    vx: f32,
    vy: f32
}

component Health {
    hp: f32
}

component Shield {
    sp: f32
}

system MovementSystem {
    query(mut pos: Position, vel: Velocity) {
        pos.x += vel.vx;
        pos.y += vel.vy;
    }
}

system ShieldRegenSystem {
    query(mut shield: Shield) {
        shield.sp += 1.0;
    }
}

system HealthRegenSystem {
    query(mut hp: Health) {
        hp.hp += 0.5;
    }
}

// 1. Parallel execution via native Windows ThreadPool
pipeline ParallelPipeline {
    stage Update {
        parallel {
            MovementSystem;
            ShieldRegenSystem;
            HealthRegenSystem;
        }
    }
}

// 2. Sequential execution on single thread
pipeline SequentialPipeline {
    stage Update {
        MovementSystem;
        ShieldRegenSystem;
        HealthRegenSystem;
    }
}

fn main(): i32 {
    println("=== ECSLang Stage 14: Multithreading & Job System ===");

    let mut world = ecs::create_world();

    let entity_count = 100000;
    println("Spawning %d entities with 4 components (Position, Velocity, Health, Shield)...", entity_count);

    let spawn_start = get_tick_count();
    for i in 0..entity_count {
        let e = world.spawn();
        world.add_Position(e, 0.0, 0.0);
        world.add_Velocity(e, 1.0, 1.0);
        world.add_Health(e, 100.0);
        world.add_Shield(e, 50.0);
    }
    let spawn_time = get_tick_count() - spawn_start;
    println("Spawned %d entities in %d ms!", entity_count, spawn_time);

    // Warm-up run
    println("Warming up...");
    SequentialPipeline(world);
    ParallelPipeline(world);

    let iterations = 10;
    println("Running benchmark: %d iterations over %d entities...", iterations, entity_count);

    // Benchmark Sequential
    let seq_start = get_tick_count();
    for iter in 0..iterations {
        SequentialPipeline(world);
    }
    let seq_time = get_tick_count() - seq_start;
    println("Sequential execution (%d iterations): %d ms", iterations, seq_time);

    // Benchmark Parallel
    let par_start = get_tick_count();
    for iter in 0..iterations {
        ParallelPipeline(world);
    }
    let par_time = get_tick_count() - par_start;
    println("Parallel ThreadPool execution (%d iterations): %d ms", iterations, par_time);

    println("=== Multithreading Job System verified successfully! ===");
    return 0;
}
