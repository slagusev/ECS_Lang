// Verification test for Stage 25: Hash Maps (HashMap<K, V>) & Named Entity Indexing

component Position {
    x: f32,
    y: f32,
}

component Health {
    hp: i32,
}

fn main(): i32 {
    println("=== Stage 25: HashMap<K, V> & Named Entity Indexing Test ===");

    // =========================================================================
    // Part 1: Testing standalone HashMap<string, i32>
    // =========================================================================
    println("--- Testing HashMap<string, i32> ---");
    let mut scores = HashMap<string, i32>();

    println($"Initial scores.len: {scores.len()}, capacity: {scores.capacity()}");

    // Insert entries
    scores.insert("Alice", 100);
    scores.insert("Bob", 250);
    scores.insert("Charlie", 500);

    println($"After 3 inserts: scores.len = {scores.len()}");
    if scores.len() != 3 {
        println("ERROR: Expected scores.len == 3");
        return 1;
    }

    // Verify .contains()
    if scores.contains("Alice") {
        println("SUCCESS: scores contains Alice");
    } else {
        println("ERROR: scores should contain Alice");
        return 2;
    }

    if !scores.contains("Unknown") {
        println("SUCCESS: scores does not contain Unknown");
    } else {
        println("ERROR: scores should not contain Unknown");
        return 3;
    }

    // Verify .get() and indexed access
    let aliceScore = scores.get("Alice");
    println($"scores.get(Alice) = {aliceScore}");
    if aliceScore != 100 {
        println("ERROR: Expected aliceScore == 100");
        return 4;
    }

    let bobScore = scores["Bob"];
    println($"scores[Bob] = {bobScore}");
    if bobScore != 250 {
        println("ERROR: Expected bobScore == 250");
        return 5;
    }

    // Indexed assignment / update
    scores["Alice"] = 150;
    let updatedAlice = scores["Alice"];
    println($"After update: scores[Alice] = {updatedAlice}");
    if updatedAlice != 150 {
        println("ERROR: Expected updated alice score == 150");
        return 6;
    }

    // Insert new via index
    scores["Dave"] = 999;
    let daveVal = scores["Dave"];
    println($"After scores[Dave] = 999: len = {scores.len()}, Dave = {daveVal}");
    if scores.len() != 4 || daveVal != 999 {
        println("ERROR: Failed indexed insert for Dave");
        return 7;
    }

    // Removal
    let remBob = scores.remove("Bob");
    println($"scores.remove(Bob) returned: {remBob}, new len = {scores.len()}");
    if !remBob || scores.len() != 3 || scores.contains("Bob") {
        println("ERROR: Failed to remove Bob");
        return 8;
    }

    // Clear
    scores.clear();
    println($"After clear(): len = {scores.len()}");
    if scores.len() != 0 {
        println("ERROR: Expected len == 0 after clear");
        return 9;
    }

    // =========================================================================
    // Part 2: Testing HashMap<i32, string> (Integer keys)
    // =========================================================================
    println("--- Testing HashMap<i32, string> ---");
    let mut namesById = HashMap<i32, string>();
    namesById.insert(1, "Warrior");
    namesById.insert(2, "Mage");
    namesById.insert(3, "Archer");

    let val1 = namesById.get(1);
    let val2 = namesById[2];
    let val3 = namesById.get(3);

    println($"namesById.len = {namesById.len()}");
    println($"id 1: {val1}");
    println($"id 2: {val2}");
    println($"id 3: {val3}");

    if val1 != "Warrior" || val2 != "Mage" {
        println("ERROR: Integer key map lookup failed");
        return 10;
    }

    // =========================================================================
    // Part 3: Testing ECS World Named Entity Indexing
    // =========================================================================
    println("--- Testing ECS World Named Entity Indexing ---");
    let mut world = ecs::create_world();

    let p = world.spawn();
    world.set_Position(p, 100.0, 200.0);
    world.set_Health(p, 100);
    world.set_name(p, "Player");

    let b = world.spawn();
    world.set_Position(b, 500.0, 300.0);
    world.set_Health(b, 1000);
    world.set_name(b, "Boss");

    let cam = world.spawn();
    world.set_Position(cam, 0.0, 0.0);
    world.set_name(cam, "MainCamera");

    println("Registered named entities: Player, Boss, MainCamera.");

    // Check world.has_name
    if world.has_name("Player") {
        println("SUCCESS: world.has_name(Player) == true");
    } else {
        println("ERROR: world should have Player");
        return 11;
    }

    if world.has_name("Boss") {
        println("SUCCESS: world.has_name(Boss) == true");
    } else {
        println("ERROR: world should have Boss");
        return 12;
    }

    if !world.has_name("Dragon") {
        println("SUCCESS: world.has_name(Dragon) == false");
    } else {
        println("ERROR: world should not have Dragon");
        return 13;
    }

    // Check world.get_by_name
    let foundPlayer = world.get_by_name("Player");
    println($"world.get_by_name(Player) -> entity {foundPlayer}");
    if foundPlayer != p {
        println($"ERROR: Expected player entity {p}, got {foundPlayer}");
        return 14;
    }

    let foundBoss = world.get_by_name("Boss");
    println($"world.get_by_name(Boss) -> entity {foundBoss}");
    if foundBoss != b {
        println($"ERROR: Expected boss entity {b}, got {foundBoss}");
        return 15;
    }

    println("=== Stage 25 HashMap & Named Indexing Tests PASSED! ===");
    return 0;
}
