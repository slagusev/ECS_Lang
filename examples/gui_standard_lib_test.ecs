import "std/gui.ecs";

fn main(): i32 {
    println("=== Stage 28: Standard ECS GUI Library Test (Pure ECSLang) ===");

    let mut world = ecs::create_world();

    // 1. Create a draggable main window panel
    println("Spawning GUI Panel (Window)...");
    let panel = gui_panel(world, 50.0, 50.0, 400.0, 500.0, "Settings & Tools Panel");

    // 2. Add Title Label
    println("Spawning UI Text Labels...");
    let title_lbl = gui_label(world, 70.0, 90.0, "Configure Simulation Options:", 16, 0x5C8AE6FF);

    // 3. Add Buttons
    println("Spawning UI Buttons...");
    let btn_save = gui_button(world, 70.0, 125.0, 150.0, 36.0, "Save Config");
    let btn_reset = gui_button(world, 240.0, 125.0, 150.0, 36.0, "Reset Defaults");

    // 4. Add Separator
    println("Spawning UI Separator...");
    let sep1 = gui_separator(world, 70.0, 175.0, 320.0, false);

    // 5. Add Checkboxes
    println("Spawning UI Checkboxes...");
    let cb_vsync = gui_checkbox(world, 70.0, 195.0, "Enable VSync 60 FPS", true);
    let cb_fullscreen = gui_checkbox(world, 70.0, 225.0, "Fullscreen Display Mode", false);

    // 6. Add Toggle Switch
    println("Spawning UI Toggle Switch...");
    let sw_bloom = gui_toggle_switch(world, 70.0, 260.0, true);
    let lbl_bloom = gui_label(world, 125.0, 262.0, "Post-Processing Bloom HDR", 14, 0xCCCCCCFF);

    // 7. Add Radio Buttons (Group 1: Difficulty)
    println("Spawning UI Radio Buttons...");
    let rb_easy = gui_radio_button(world, 70.0, 295.0, "Easy Mode", 1, false);
    let rb_norm = gui_radio_button(world, 170.0, 295.0, "Normal Mode", 1, true);
    let rb_hard = gui_radio_button(world, 280.0, 295.0, "Hardcore Mode", 1, false);

    // 8. Add Separator
    let sep2 = gui_separator(world, 70.0, 330.0, 320.0, false);

    // 9. Add Sliders (Master Volume & Sensitivity)
    println("Spawning UI Sliders...");
    let lbl_vol = gui_label(world, 70.0, 345.0, "Master Audio Volume: 75%", 14, 0xFFFFFFFF);
    let s_vol = gui_slider(world, 70.0, 370.0, 320.0, 24.0, 0.0, 100.0, 75.0);

    let lbl_sens = gui_label(world, 70.0, 405.0, "Mouse Sensitivity: 1.5x", 14, 0xFFFFFFFF);
    let s_sens = gui_slider(world, 70.0, 430.0, 320.0, 24.0, 0.5, 5.0, 1.5);

    // 10. Add Progress Bar (Asset Preloading Status)
    println("Spawning UI Progress Bar...");
    let lbl_prog = gui_label(world, 70.0, 465.0, "Asset Loading Status:", 13, 0xAAAAAAFF);
    let p_bar = gui_progress_bar(world, 70.0, 485.0, 320.0, 16.0, 0.65);

    // 11. Add Tooltip
    println("Spawning UI Tooltip...");
    gui_tooltip(world, btn_save, "Click to save all current settings to disk");

    println("All UI components and widgets spawned successfully!");

    // Execute GUIPipeline in simulated mode (10 frames)
    println("Running GUIPipeline for 10 simulation frames...");
    let mut frame = 0;
    while frame < 10 {
        GUIPipeline(world);
        frame += 1;
    }

    println("SUCCESS: GUIPipeline executed 10 frames smoothly!");
    println("=== Stage 28 Pure ECSLang Standard GUI Library Test PASSED! ===");
    return 0;
}
