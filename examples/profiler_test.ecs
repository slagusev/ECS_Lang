// Verification test for Stage 24: Built-in Visual ECS Profiler & Inspector (F1)

component Position {
    x: f32,
    y: f32,
}

component Velocity {
    vx: f32,
    vy: f32,
}

component Health {
    hp: i32,
}

component PlayerTag {
    id: i32,
}

system MovementSystem {
    query(mut pos: Position, vel: Velocity) {
        pos.x += vel.vx;
        pos.y += vel.vy;
    }
}

pipeline GamePipeline {
    stage Update {
        MovementSystem;
    }
}

fn main(): i32 {
    println("=== Stage 24: Visual ECS Profiler & Inspector Test ===");

    let mut world = ecs::create_world();

    // 1. Spawn entities across multiple distinct archetypes
    // Archetype A: Position + Velocity
    let e1 = world.spawn();
    world.set_Position(e1, 10.0, 20.0);
    world.set_Velocity(e1, 1.0, 0.0);

    let e2 = world.spawn();
    world.set_Position(e2, 30.0, 40.0);
    world.set_Velocity(e2, 0.5, 1.5);

    // Archetype B: Position + PlayerTag
    let p = world.spawn();
    world.set_Position(p, 100.0, 100.0);
    world.set_PlayerTag(p, 1);

    // Archetype C: Position + Velocity + Health
    let boss = world.spawn();
    world.set_Position(boss, 500.0, 300.0);
    world.set_Velocity(boss, -2.0, 0.0);
    world.set_Health(boss, 1000);

    println("Created entities in 3 archetypes successfully.");

    // 2. Step pipeline
    GamePipeline(world);
    println("Pipeline stepped.");

    // 3. Test calling world.render_profiler() (Safe fallback in headless / console mode)
    println("Calling world.render_profiler()...");
    world.render_profiler();

    // 4. Test calling global render_profiler(world)
    println("Calling render_profiler(world)...");
    render_profiler(world);

    println("Profiler headless safe fallback verified successfully!");
    println("=== Stage 24 Profiler Test PASSED! ===");
    return 0;
}
