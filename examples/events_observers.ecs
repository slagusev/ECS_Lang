// Stage 13: Events & Observers Test
// Demonstrates:
// 1. event declaration
// 2. emitting events via world.emit_Event(...) and world.emit(Event(...))
// 3. double-buffered queue with swap_events in pipeline
// 4. observer systems: read(ev: Event, mut res: Resource)

component Position {
    x: f32,
    y: f32
}

component Velocity {
    vx: f32,
    vy: f32
}

component Health {
    hp: f32
}

resource GameStats {
    total_events: i32
}

event Collision {
    entity_a: i32,
    entity_b: i32,
    force: f32
}

event GameOver {
    winner_id: i32
}

system MovementSystem {
    query(mut pos: Position, vel: Velocity) {
        pos.x = pos.x + vel.vx;
        pos.y = pos.y + vel.vy;
        println("Entity moved to: %f, %f", pos.x, pos.y);

        if (pos.x > 10.0) {
            println("Triggering collision from MovementSystem!");
            world.emit_Collision(1, 2, 45.5);
        }
    }
}

system DamageObserver {
    read(col: Collision, mut stats: GameStats) {
        stats.total_events = stats.total_events + 1;
        println("DamageObserver: Handled Collision between %d and %d (force: %f). Total: %d",
                col.entity_a, col.entity_b, col.force, stats.total_events);
    }
}

system GameOverObserver {
    read(go: GameOver, mut stats: GameStats) {
        stats.total_events = stats.total_events + 1;
        println("GameOverObserver: Game over! Winner is entity %d. Total: %d",
                go.winner_id, stats.total_events);
    }
}

pipeline GamePipeline {
    stage Physics {
        MovementSystem;
    }
    stage Reaction {
        swap_events;
        DamageObserver;
        GameOverObserver;
    }
}

fn main(): i32 {
    println("=== ECSLang Stage 13: Events & Observers ===");

    let mut world = ecs::create_world();
    world.set_GameStats(0);

    let e = world.spawn();
    world.add_Position(e, 8.0, 0.0);
    world.add_Velocity(e, 1.5, 0.0);
    world.add_Health(e, 100.0);

    println("--- Tick 1 (pos reaches 9.5, no event emitted) ---");
    GamePipeline(world);

    println("--- Tick 2 (pos reaches 11.0, emits Collision event) ---");
    GamePipeline(world);

    println("--- Manual emission of GameOver event via constructor syntax ---");
    world.emit(GameOver(1));
    GamePipeline(world);

    println("=== All event systems executed successfully! ===");
    return 0;
}
