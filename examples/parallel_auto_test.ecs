// ========================================================================
// ECSLang Example: Parallel Auto DAG Scheduler Test
// Demonstrates automatic compile-time dependency graph (DAG) batching
// inside pipeline stages via 'parallel auto { ... }'.
// ========================================================================

component Position {
    x: f32,
    y: f32,
}

component Velocity {
    vx: f32,
    vy: f32,
}

component Shield {
    value: f32,
    max_value: f32,
}

component Health {
    value: f32,
    max_value: f32,
}

// 1. MovementSystem: mut Position, read Velocity
system MovementSystem {
    query(mut pos: Position, vel: Velocity) {
        pos.x += vel.vx;
        pos.y += vel.vy;
    }
}

// 2. CollisionSystem: mut Position (conflicts with MovementSystem: write-write Position)
system CollisionSystem {
    query(mut pos: Position) {
        if pos.x > 100.0 {
            pos.x = 100.0;
        }
        if pos.y > 100.0 {
            pos.y = 100.0;
        }
    }
}

// 3. ShieldRegenSystem: mut Shield (independent, can run in parallel with Movement and Health)
system ShieldRegenSystem {
    query(mut shield: Shield) {
        if shield.value < shield.max_value {
            shield.value += 5.0;
            if shield.value > shield.max_value {
                shield.value = shield.max_value;
            }
        }
    }
}

// 4. HealthRegenSystem: mut Health (independent, can run in parallel with Movement and Shield)
system HealthRegenSystem {
    query(mut health: Health) {
        if health.value < health.max_value {
            health.value += 2.0;
            if health.value > health.max_value {
                health.value = health.max_value;
            }
        }
    }
}

// 5. LoggerSystem: read Position (conflicts with CollisionSystem: read-write Position)
system LoggerSystem {
    query(pos: Position) {
        // Read final clamped position
    }
}

// Pipeline with automated DAG scheduling:
// Batch 0 (Parallel): [MovementSystem, ShieldRegenSystem, HealthRegenSystem]
// Thread Barrier
// Batch 1 (Sequential): [CollisionSystem]
// Thread Barrier
// Batch 2 (Sequential): [LoggerSystem]
// Thread Barrier
pipeline AutoScheduleSimulationPipeline {
    stage Simulation {
        parallel auto {
            MovementSystem;
            CollisionSystem;
            ShieldRegenSystem;
            HealthRegenSystem;
            LoggerSystem;
        }
    }
}

fn main(): i32 {
    println("=================================================");
    println("   ECSLang Automatic Parallel DAG Scheduler     ");
    println("=================================================\n");

    let mut world = ecs::create_world();

    // Spawn 100 simulation entities
    println("1. Spawning 100 simulation entities...");
    for i in 0..100 {
        let e = world.spawn();
        world.set_Position(e, 10.0, 10.0);
        world.set_Velocity(e, 2.0, 3.0);
        world.set_Shield(e, 50.0, 100.0);
        world.set_Health(e, 80.0, 100.0);
    }

    println("2. Executing AutoScheduleSimulationPipeline for 10 frames...");
    for frame in 0..10 {
        AutoScheduleSimulationPipeline(world);
    }

    println("\n3. Verifying simulation state...");
    println("   - ShieldRegen and HealthRegen executed concurrently in worker threads");
    println("   - Movement, Collision, and Logger executed with verified sequential causality");

    println("\n[Parallel Auto Test] SUCCESS: All 5 systems executed without data races!");
    println("Press any key to exit...");
    wait_key();
    return 0;
}
