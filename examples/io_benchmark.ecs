// ========================================================================
// ECSLang Big Data I/O Benchmark (Fair Atomic Mode)
// Apples-to-Apples Comparison with C# (.NET 9)
// ========================================================================

fn run_io_benchmark(): Result<bool, string> {
    let log_path = "bench_ecslang.log";
    let iterations = 1000000;
    let log_line = "[INFO] 2026-10-02 12:00:00 - Parallel System Data Pipeline Processing Tick\n";

    println("=== ECSLang Big Data I/O Benchmark (Fair Atomic Mode) ===");

    // Инициализируем/очищаем файл перед тестом
    file_write_text(log_path, "")?;

    // 1. Тест записи (1 млн итераций: open -> lock -> write -> close под капотом функции)
    let start_write = stopwatch_start();
    for i in 0..iterations {
        file_append_text(log_path, log_line)?;
    }
    let write_ms = stopwatch_ms(start_write);
    println($"ECSLang Запись {iterations} строк (Atomic): {write_ms:.2f} ms");

    // 2. Тест чтения файла целиком
    let start_read = stopwatch_start();
    let content = file_read_text(log_path)?;
    let read_ms = stopwatch_ms(start_read);
    
    let file_size_mb = (content.len() as f32) / (1024.0 * 1024.0);
    println($"ECSLang Чтение файла ({file_size_mb:.2f} MB): {read_ms:.2f} ms");

    return Result::Ok(true);
}

fn main(): i32 {
    run_io_benchmark()?;
    println("\n[Benchmark] Нажми любую клавишу для завершения...");
    wait_key();
    return 0;
}
