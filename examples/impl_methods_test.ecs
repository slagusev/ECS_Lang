// End-to-end verification test for Stage 22: Struct Methods (impl Struct)

struct Vector2 {
    x: f32,
    y: f32,
}

impl Vector2 {
    fn zero(): Vector2 {
        return Vector2(0.0, 0.0);
    }

    fn create(x: f32, y: f32): Vector2 {
        return Vector2(x, y);
    }

    fn length_sq(self): f32 {
        return self.x * self.x + self.y * self.y;
    }

    fn dot(self, other: Vector2): f32 {
        return self.x * other.x + self.y * other.y;
    }

    fn scale(mut self, factor: f32): void {
        self.x *= factor;
        self.y *= factor;
    }

    fn add_in_place(mut self, other: Vector2): void {
        self.x += other.x;
        self.y += other.y;
    }
}

component Position {
    x: f32,
    y: f32,
}

impl Position {
    fn translate(mut self, dx: f32, dy: f32): void {
        self.x += dx;
        self.y += dy;
    }

    fn dist_sq(self, ox: f32, oy: f32): f32 {
        let dx = self.x - ox;
        let dy = self.y - oy;
        return dx * dx + dy * dy;
    }
}

system MoveSystem {
    query(mut pos: Position) {
        pos.translate(5.0, 10.0);
    }
}

pipeline TestPipeline {
    stage Update {
        MoveSystem;
    }
}

fn main(): i32 {
    println("=== Stage 22: User Struct Methods (impl Struct) Test ===");

    // 1. Static/Associated constructor
    let mut v = Vector2::create(3.0, 4.0);
    println("Vector2 created: x=%f, y=%f", v.x, v.y);

    // 2. Read-only method (self)
    let len_sq = v.length_sq();
    println("Length squared: %f (expected 25.0)", len_sq);

    let other = Vector2(1.0, 2.0);
    let d = v.dot(other);
    println("Dot product with (1, 2): %f (expected 11.0)", d);

    // 3. Mutating method (mut self)
    println("Scaling vector by 2.0...");
    v.scale(2.0);
    println("After scale: x=%f, y=%f (expected 6.0, 8.0)", v.x, v.y);
    println("New length squared: %f (expected 100.0)", v.length_sq());

    println("Adding in place (4.0, -8.0)...");
    v.add_in_place(Vector2(4.0, -8.0));
    println("After add_in_place: x=%f, y=%f (expected 10.0, 0.0)", v.x, v.y);

    // 4. Methods on Component inside ECS World
    println("--- Testing methods on ECS components ---");
    let mut world = ecs::create_world();
    let e = world.spawn();
    world.set_Position(e, 100.0, 200.0);

    TestPipeline(world);

    println("Checking Position after pipeline step...");
    println("Pipeline executed successfully!");

    println("=== All Stage 22 tests PASSED! ===");
    return 0;
}
