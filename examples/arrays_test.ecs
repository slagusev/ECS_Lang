component Inventory {
    items: [i32; 4]
}

system UpdateInventory {
    query(mut inv: Inventory) {
        for i in 0..4 {
            inv.items[i] += (i + 1) * 10;
        }
    }
}

system PrintInventory {
    query(inv: Inventory) {
        for i in 0..4 {
            println("Inventory slot %d: %d", i, inv.items[i]);
        }
    }
}

pipeline GameLoop {
    stage Update {
        UpdateInventory;
        PrintInventory;
    }
}

fn main(): i32 {
    println("--- Test 1: Local Arrays ---");
    let mut numbers: [i32; 5] = [10, 20, 30, 40, 50];
    println("Initial numbers[2] = %d", numbers[2]);
    numbers[2] = 99;
    println("Updated numbers[2] = %d", numbers[2]);
    numbers[2] += 1;
    println("After += 1 numbers[2] = %d", numbers[2]);

    println("--- Test 2: For Loop over Array ---");
    for i in 0..5 {
        println("numbers[%d] = %d", i, numbers[i]);
    }

    println("--- Test 3: Component Array ---");
    let mut world = ecs::create_world();
    let e = world.spawn();
    world.add_Inventory(e, [100, 200, 300, 400]);

    println("Running pipeline...");
    GameLoop(world);

    println("Arrays test completed successfully!");
    return 0;
}
