// ECS-Lang: Comprehensive String and Math Standard Library Test

fn test_strings() {
    println("=== 1. String Concatenation & to_string ===");
    let greeting: string = "Hello";
    let target: string = "World";
    let combined: string = greeting + ", " + target + "!";
    println(combined);

    let score: i32 = 100;
    let score_str: string = "Score: " + score;
    println(score_str);

    let health: f32 = 95.5;
    let hp_str: string = "HP: " + health.to_string();
    println(hp_str);

    let alive: bool = true;
    let status_str: string = "Alive: " + to_string(alive);
    println(status_str);

    println("=== 2. String Length & Member Access ===");
    println("Length of 'Hello' via .len: " + greeting.len);
    println("Length of 'World' via .len(): " + target.len());
    println("Length of 'Hello' via str_len: " + str_len(greeting));

    println("=== 3. String Equality & Comparison ===");
    let s1: string = "antigravity";
    let s2: string = "antigravity";
    let s3: string = "gravity";

    if s1 == s2 {
        println("s1 == s2: TRUE (Correct)");
    } else {
        println("s1 == s2: FALSE (Bug!)");
    }

    if s1 != s3 {
        println("s1 != s3: TRUE (Correct)");
    } else {
        println("s1 != s3: FALSE (Bug!)");
    }

    println("=== 4. String Interpolation ($ and f) ===");
    let player_name: string = "Hero";
    let level: i32 = 5;
    let speed: f32 = 12.5;

    let info_dollar: string = $"Player: {player_name} (Level {level}), Speed: {speed}";
    println(info_dollar);

    let info_f: string = f"Next Level: {level + 1}, Speed Boost: {speed + 2.5}";
    println(info_f);
}

fn test_math() {
    println("=== 5. Standard Math Library ===");

    let val_f: f32 = 16.0;
    let root: f32 = sqrt(val_f);
    println("sqrt(16.0) = " + root);

    let angle: f32 = 0.0;
    println("sin(0.0) = " + sin(angle));
    println("cos(0.0) = " + cos(angle));

    let val_float: f32 = 3.75;
    println("floor(3.75) = " + floor(val_float));
    println("ceil(3.75) = " + ceil(val_float));

    let neg_i: i32 = -42;
    println("abs(-42) = " + abs(neg_i));
    let neg_f: f32 = -3.14;
    println("abs(-3.14) = " + abs(neg_f));

    let a: i32 = 10;
    let b: i32 = 25;
    println("min(10, 25) = " + min(a, b));
    println("max(10, 25) = " + max(a, b));

    let clamped_low: i32 = clamp(5, 10, 20);
    let clamped_mid: i32 = clamp(15, 10, 20);
    let clamped_high: i32 = clamp(35, 10, 20);
    println($"clamp results: {clamped_low}, {clamped_mid}, {clamped_high}");

    let r: i32 = rand_range(1, 10);
    println("rand_range(1, 10) = " + r);
}

fn main() {
    println("--- START STRING & MATH SUITE ---");
    test_strings();
    test_math();
    println("--- STRING & MATH SUITE PASSED ---");
}
