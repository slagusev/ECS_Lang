// =========================================================================
// ECSLang Stage 32: Pure Data-Oriented Network Test (TCP & UDP)
// =========================================================================

import "std/net.ecs";

system EchoHandlerSystem {
    read(packet: NetPacketReceived) {
        println($"[Server System] Received inbound packet: '{packet.payload}' from fd={packet.fd}");
        if packet.payload == "UDP Datagram to ECS!" {
            net_udp_send_to(packet.fd, "127.0.0.1", 39873, $"ECHO: {packet.payload}");
        } else {
            let echo_payload = $"ECHO: {packet.payload}";
            world.emit_NetPacketSend(packet.fd, echo_payload);
        }
    }
}

pipeline NetEchoServerPipeline {
    stage NetPoll {
        TcpListenerSystem;
        TcpReceiverSystem;
        UdpReceiverSystem;
    }
    stage BusinessLogic {
        swap_events;
        EchoHandlerSystem;
    }
    stage NetFlush {
        swap_events;
        OutboundSendSystem;
    }
}

fn main(): i32 {
    println("=== ECSLang Stage 32 Network Subsystem Test ===");

    // 1. Initialize Network Subsystem (WSAStartup on Windows)
    let init_res = net_start();
    println($"1. Net initialization result: {init_res}");

    // 2. Setup Server Sockets (TCP on 39871, UDP on 39872)
    let tcp_port = 39871;
    let udp_server_port = 39872;
    let udp_client_port = 39873;

    let server_tcp_fd = net_tcp_listen(tcp_port);
    if server_tcp_fd <= 0 {
        println($"ERROR: Failed to bind TCP listener on port {tcp_port}");
        return 1;
    }
    println($"2. TCP Server listening on port {tcp_port} (fd={server_tcp_fd})");

    let server_udp_fd = net_udp_bind(udp_server_port);
    if server_udp_fd <= 0 {
        println($"ERROR: Failed to bind UDP server on port {udp_server_port}");
        net_close(server_tcp_fd);
        return 1;
    }
    println($"3. UDP Server bound on port {udp_server_port} (fd={server_udp_fd})");

    // 3. Connect TCP Client and Bind UDP Client
    let client_tcp_fd = net_tcp_connect("127.0.0.1", tcp_port);
    if client_tcp_fd <= 0 {
        println("ERROR: Failed to connect TCP client");
        net_close(server_tcp_fd);
        net_close(server_udp_fd);
        return 1;
    }
    println($"4. TCP Client connected (fd={client_tcp_fd})");

    let client_udp_fd = net_udp_bind(udp_client_port);
    if client_udp_fd <= 0 {
        println("ERROR: Failed to bind UDP client");
        net_close(client_tcp_fd);
        net_close(server_tcp_fd);
        net_close(server_udp_fd);
        return 1;
    }
    println($"5. UDP Client bound on port {udp_client_port} (fd={client_udp_fd})");

    // 4. Set up Pure ECS World and Spawn Entities for TCP Listener and UDP Socket
    let mut world = ecs::create_world();

    let tcp_srv_ent = world.spawn();
    world.set_TcpListener(tcp_srv_ent, tcp_port, server_tcp_fd, true);

    let udp_srv_ent = world.spawn();
    world.set_UdpSocket(udp_srv_ent, udp_server_port, server_udp_fd);

    // 5. Tick 1: Server accepts incoming TCP client connection via TcpListenerSystem
    NetEchoServerPipeline(world);

    // 6. Clients transmit payloads over TCP and UDP
    let sent_tcp = net_tcp_send(client_tcp_fd, "Hello ECSLang Network!");
    println($"6. Client sent {sent_tcp} bytes over TCP");

    let sent_udp = net_udp_send_to(client_udp_fd, "127.0.0.1", udp_server_port, "UDP Datagram to ECS!");
    println($"7. Client sent {sent_udp} bytes over UDP");

    // 7. Tick 2: Server processes inbound TCP & UDP packets in pure ECS pipeline:
    //    - Stage NetPoll: TcpReceiverSystem & UdpReceiverSystem poll sockets and emit NetPacketReceived
    //    - Stage BusinessLogic: EchoHandlerSystem handles both packets via read(packet: NetPacketReceived)
    //    - Stage NetFlush: OutboundSendSystem flushes echo responses back
    NetEchoServerPipeline(world);

    // 8. Client receives TCP Echo response with non-blocking poll loop
    let mut tcp_reply = "";
    while tcp_reply.len() == 0 {
        tcp_reply = net_tcp_recv(client_tcp_fd, 1024);
    }
    println($"8. Client received TCP response: '{tcp_reply}'");

    // 9. Client receives UDP Echo response with non-blocking poll loop
    let mut udp_reply = "";
    while udp_reply.len() == 0 {
        udp_reply = net_udp_recv_from(client_udp_fd, 1024);
    }
    println($"9. Client received UDP response: '{udp_reply}'");

    // 10. Clean up
    net_close(client_tcp_fd);
    net_close(client_udp_fd);
    net_close(server_tcp_fd);
    net_close(server_udp_fd);
    net_stop();

    println("=== Stage 32 Network Subsystem Verification SUCCESS ===");
    return 0;
}
