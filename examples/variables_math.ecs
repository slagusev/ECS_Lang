fn main(): i32 {
    let mut i = 0;
    let mut total: f32 = 0.0;

    while (i < 5) {
        total += 2.5;
        i += 1;
    }

    println("Computed Total (should be 12.5):");
    println(total);

    println("Iterations count (should be 5):");
    println(i);

    if (total > 10.0) {
        println("Verification passed: total is greater than 10.0!");
    } else {
        println("Verification failed!");
    }

    println("Press Enter to exit...");
    wait_key();
    return 0;
}
