component Position {
    x: f32,
    y: f32,
    z: f32,
}

component Velocity {
    vx: f32,
    vy: f32,
    vz: f32,
}

resource Time {
    dt: f32,
}

system MovementSystem {
    query(mut pos: Position, vel: Velocity, time: Time) {
        pos.x += vel.vx * time.dt;
        pos.y += vel.vy * time.dt;
        pos.z += vel.vz * time.dt;
    }
}

pipeline PhysicsPipeline {
    stage Update {
        MovementSystem;
    }
}

fn main(): i32 {
    println("==================================================");
    println("  ECS-Lang: 100,000 Particles Benchmark");
    println("==================================================");

    world_set_Time(0.016);

    println("Spawning 100,000 entities into Archetype SoA storage...");
    let mut i = 0;
    while (i < 100000) {
        let e = world_spawn();
        world_set_Position(e, 0.0, 0.0, 0.0);
        world_set_Velocity(e, 1.0, 2.0, 3.0);
        i += 1;
    }
    println("Spawn completed! Total entities:");
    println(i);

    println("Running 10 physics simulation frames over 100,000 entities...");
    let mut frame = 0;
    while (frame < 10) {
        PhysicsPipeline();
        frame += 1;
    }

    println("Simulation finished 10 frames successfully!");
    println("==================================================");
    println("Press Enter to exit...");
    wait_key();
    return 0;
}
