// Stage 30 Comprehensive Test: Generics & Traits

trait Printable {
    fn print(self);
}

struct Point {
    x: i32,
    y: i32,
}

impl Printable for Point {
    fn print(self) {
        print("Point(");
        print(self.x);
        print(", ");
        print(self.y);
        println(")");
    }
}

struct Pair<T, U> {
    first: T,
    second: U,
}

impl<T, U> Pair<T, U> {
    fn get_first(self): T {
        return self.first;
    }
    fn get_second(self): U {
        return self.second;
    }
}

component Node<T> {
    value: T,
}

system NodePrinter<T> {
    query(n: Node<T>) {
        print("Node query value: ");
        println(n.value);
    }
}

pipeline TestPipeline {
    stage PrintNodes {
        NodePrinter<i32>;
        NodePrinter<string>;
    }
}

fn identity<T>(x: T): T {
    return x;
}

fn swap_pair<T>(p: Pair<T, T>): Pair<T, T> {
    return Pair<T, T>(p.second, p.first);
}

fn show<T: Printable>(item: T) {
    item.print();
}

fn main(): i32 {
    println("=== ECSLang Stage 30 Generics & Traits Test ===");
    // 1. Generic Functions & Type Inference
    println("--- Testing Generic Functions ---");
    let int_val: i32 = identity<i32>(42);
    print("identity<i32>(42) = ");
    println(int_val);

    let str_val: string = identity<string>("Generics in ECSLang!");
    print("identity<string> = ");
    println(str_val);

    // 2. Generic Structs and Impl Methods
    println("--- Testing Generic Structs & Methods ---");
    let pair = Pair<i32, string>(100, "Century");
    print("pair.first = ");
    println(pair.first);
    print("pair.second = ");
    println(pair.second);

    print("pair.get_first() = ");
    println(pair.get_first());
    print("pair.get_second() = ");
    println(pair.get_second());

    let num_pair = Pair<i32, i32>(10, 20);
    let swapped = swap_pair<i32>(num_pair);
    print("swapped.first = ");
    println(swapped.first);
    print("swapped.second = ");
    println(swapped.second);

    // 3. Traits and Trait Bounds
    println("--- Testing Traits & Trait Bounds ---");
    let pt = Point(15, 25);
    print("Direct trait method call: ");
    pt.print();

    print("Generic function with Trait bound show<Point>: ");
    show<Point>(pt);

    // 4. Generic Components & Generic Systems
    println("--- Testing Generic Components & Systems ---");
    let world = create_world();
    let e1 = world.spawn();
    world.add(e1, Node<i32>(777));

    let e2 = world.spawn();
    world.add(e2, Node<string>("Entity with generic node!"));

    println("Calling TestPipeline(world)...");
    TestPipeline(world);
    println("TestPipeline(world) finished successfully!");

    println("=== Stage 30 Generics & Traits Verification SUCCESS ===");
    return 0;
}
