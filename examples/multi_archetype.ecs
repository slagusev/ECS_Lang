component Position {
    x: f32,
    y: f32,
}

component Velocity {
    vx: f32,
    vy: f32,
}

component PlayerTag {
    id: i32,
}

component Obstacle {
    solid: bool,
}

resource Time {
    dt: f32,
}

system MovementSystem {
    query(mut pos: Position, vel: Velocity, time: Time) {
        pos.x += vel.vx * time.dt;
        pos.y += vel.vy * time.dt;
    }
}

system PrintPlayerSystem {
    query(pos: Position, player: PlayerTag) {
        println("Player Position:");
        println(pos.x);
        println(pos.y);
    }
}

system PrintObstacleSystem {
    query(pos: Position, obs: Obstacle) {
        println("Obstacle Position:");
        println(pos.x);
        println(pos.y);
    }
}

pipeline PhysicsLoop {
    stage Physics {
        MovementSystem;
    }
}

fn main(): i32 {
    println("==================================================");
    println("  ECS-Lang: Multi-Archetype Dynamic ECS Demo      ");
    println("==================================================");

    let mut world = ecs::create_world();
    world.set_Time(1.0);

    // 1. Spawn Player: Archetype { Position, Velocity, PlayerTag }
    let player = world.spawn();
    world.set_Position(player, 10.0, 20.0);
    world.set_Velocity(player, 5.0, 2.0);
    world.set_PlayerTag(player, 1);

    // 2. Spawn Rock: Archetype { Position, Obstacle }
    let rock = world.spawn();
    world.set_Position(rock, 100.0, 100.0);
    world.set_Obstacle(rock, true);

    // 3. Spawn Bullet: Archetype { Position, Velocity }
    let bullet = world.spawn();
    world.set_Position(bullet, 50.0, 50.0);
    world.set_Velocity(bullet, 10.0, 0.0);

    println("Verifying initial component presence:");
    let playerHasVel = world.has_Velocity(player);
    println("Player has Velocity (expected 1):");
    println(playerHasVel);

    let rockHasVel = world.has_Velocity(rock);
    println("Rock has Velocity (expected 0):");
    println(rockHasVel);

    let rockHasObs = world.has_Obstacle(rock);
    println("Rock has Obstacle (expected 1):");
    println(rockHasObs);

    println("--- Frame 1: Running PhysicsLoop ---");
    PhysicsLoop(world);

    println("Player after frame 1 (expected 15.0, 22.0):");
    PrintPlayerSystem(world);

    println("Obstacle after frame 1 (expected 100.0, 100.0 - unmoved):");
    PrintObstacleSystem(world);

    // 4. Test dynamic component removal: remove Velocity from bullet
    println("--- Removing Velocity from Bullet ---");
    world.remove_Velocity(bullet);
    let bulletHasVelAfter = world.has_Velocity(bullet);
    println("Bullet has Velocity after removal (expected 0):");
    println(bulletHasVelAfter);

    // 5. Test dynamic component addition: add Velocity to Rock (it begins rolling!)
    println("--- Dynamically adding Velocity to Rock ---");
    world.add_Velocity(rock, 1.0, 2.0);
    let rockHasVelAfter = world.has_Velocity(rock);
    println("Rock has Velocity after addition (expected 1):");
    println(rockHasVelAfter);

    println("--- Frame 2: Running PhysicsLoop again ---");
    PhysicsLoop(world);

    println("Player after frame 2 (expected 20.0, 24.0):");
    PrintPlayerSystem(world);

    println("Obstacle after frame 2 (expected 101.0, 102.0 - moved because Velocity was added!):");
    PrintObstacleSystem(world);

    println("==================================================");
    println("Multi-Archetype verification successful!");
    println("==================================================");
    return 0;
}
