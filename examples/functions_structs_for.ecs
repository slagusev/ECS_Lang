struct Vector2 {
    x: f32,
    y: f32,
}

component Position {
    x: f32,
    y: f32,
}

component Velocity {
    vx: f32,
    vy: f32,
}

system MovementSystem {
    query(mut pos: Position, vel: Velocity) {
        pos.x += vel.vx;
        pos.y += vel.vy;
    }
}

pipeline PhysicsPipeline {
    stage Update {
        MovementSystem;
    }
}

fn add_vectors(a: Vector2, b: Vector2): Vector2 {
    return Vector2(a.x + b.x, a.y + b.y);
}

fn calculate_sum(limit: i32): i32 {
    let mut total = 0;
    for i in 1..limit {
        total = total + i;
    }
    return total;
}

fn main(): i32 {
    println("=== ECSLang Stage 11 Features Test ===");

    // 1. User Structs and Custom Functions
    println("--- Testing Structs and Functions ---");
    let v1 = Vector2(10.0, 20.0);
    let v2 = Vector2(5.5, 4.5);
    let mut v3 = add_vectors(v1, v2);

    print("v3.x = ");
    println(v3.x);
    print("v3.y = ");
    println(v3.y);

    // Struct mutation
    v3.x += 100.0;
    print("v3.x after += 100.0 = ");
    println(v3.x);

    // 2. Range-based For Loop
    println("--- Testing Range-based For Loop ---");
    let mut loopSum = 0;
    for i in 0..5 {
        print("Loop iteration i = ");
        println(i);
        loopSum = loopSum + i;
    }
    print("Sum of 0..5 = ");
    println(loopSum);

    // 3. For loop inside function call
    let funcSum = calculate_sum(6);
    print("Sum of 1..6 via function = ");
    println(funcSum);

    // 4. ECS Integration with System and Pipeline
    println("--- Testing ECS World Integration ---");
    let mut world = ecs::create_world();
    let e = world.spawn();
    world.set_Position(e, 100.0, 200.0);
    world.set_Velocity(e, 1.5, -2.5);

    for step in 0..3 {
        print("Running physics step ");
        println(step);
        PhysicsPipeline(world);
    }

    println("Stage 11 tests completed successfully!");
    return 0;
}
